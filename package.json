{
  "name": "worklab-mindmap",
  "version": "0.1.0",
  "private": true,
  "description": "Mindmap collaboratif en ligne",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "package": "rm -f ../worklab-mindmap.zip && zip -rq ../worklab-mindmap.zip . -x \"node_modules/*\" \"data/*\" \".env\" \".claude/*\" \".DS_Store\" && echo \"Archive créée : ../worklab-mindmap.zip\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
