# Copier ce fichier en .env (en local) ou saisir ces variables dans hPanel (Hostinger).

NODE_ENV=production
PORT=3000

# Clé secrète des sessions : une longue chaîne aléatoire, à garder privée.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Base de données MySQL (créée dans hPanel > Bases de données MySQL).
# Sans DB_CLIENT=mysql, l'application utilise un fichier SQLite local (pratique pour le développement).
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Dossier des images et documents envoyés : choisir un dossier conservé entre deux déploiements.
UPLOAD_DIR=
MAX_UPLOAD_MB=20

# Inscriptions ouvertes à tous (true) ou fermées (false : seuls les comptes existants se connectent).
ALLOW_SIGNUP=true
# Cet e-mail devient administrateur à l'inscription (le tout premier compte l'est aussi).
ADMIN_EMAIL=
